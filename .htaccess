RewriteEngine On

# nao mexe nos endpoints internos (chamados pelo n8n/Stripe com .php)

# redireciona pedidos com .php para a URL sem extensao
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/+(?!api/)([^?\s]+?)\.php[?\s] [NC]
RewriteRule ^ /%1 [R=301,L]

# serve o arquivo .php quando a URL vem sem extensao
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]
